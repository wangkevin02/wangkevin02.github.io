{% assign updates = site.data.updates | sort: 'date' | reverse %}
{% if updates and updates.size > 0 %}
  <section class="updates-section" id="news" aria-labelledby="updates-heading">
    <h2 id="updates-heading">News</h2>
    <ol class="updates-list">
      {% for item in updates limit: 3 %}
        {% include update_item.liquid item=item %}
      {% endfor %}
    </ol>
    {% if updates.size > 3 %}
      <details class="updates-archive">
        <summary>
          More updates <span>({{ updates.size | minus: 3 }})</span>
        </summary>
        <ol class="updates-list">
          {% for item in updates offset: 3 %}
            {% include update_item.liquid item=item %}
          {% endfor %}
        </ol>
      </details>
    {% endif %}
  </section>
{% endif %}

{% assign education = site.data.cv.cv.sections.Education %}
<section class="home-highlights" id="background" aria-labelledby="background-heading">
  <h2 id="background-heading">Education</h2>
  {% for item in education %}
    {% assign school = site.data.institutions[item.url] %}
    <div class="education-item">
      {% if school.logo -%}
        <img class="education-logo" src="{{ school.logo | relative_url }}" alt="{{ item.institution }} emblem" width="48" height="48" loading="lazy">
      {%- endif %}
      <div class="home-highlight-item">
        <div class="home-highlight-title">
          <strong
            ><a href="{{ item.url }}">{{ item.institution }}</a></strong
          >
          <span>
            {{- item.start_date | append: '-01' | date: '%Y' }}–
            {%- if item.end_date == 'present' %}Present{% else %}{{ item.end_date | append: '-01' | date: '%Y' }}{% endif -%}
          </span>
        </div>
        <p class="education-degree">
          <span class="degree-tag">{{ item.degree }}</span> <span>{{ item.area | split: ' · ' | first }}</span>
        </p>
      </div>
    </div>
  {% endfor %}
</section>
